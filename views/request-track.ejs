<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>Track Request <%= request.id %></title>
  </head>
  <body class="app-body">
    <div class="dashboard-shell">
      <%- include('partials/sidebar', { user, active: 'dashboard' }) %>
      <main class="main-panel">
        <%- include('partials/topbar', {
          title: 'Track Request ' + request.id,
          subtitle: 'Monitor status, schedule, and OCR verification results.',
          actionsHtml: '<a class="btn-link" href="/student/dashboard">Back to Dashboard</a>'
        }) %>

        <% if (error) { %><div class="alert error"><%= error %></div><% } %>
        <% if (success) { %><div class="alert success"><%= success %></div><% } %>

        <section class="hero-banner">
          <h2>Status: <%= request.status %></h2>
          <p>
            Clearance: <%= request.clearanceStatus %>
            <% if (request.schedule) { %>
              | Release Schedule: <%= request.schedule.date %> <%= request.schedule.time %>
            <% } %>
          </p>
        </section>

        <section class="grid">
          <section class="card">
            <h2>Request Details</h2>
            <dl class="detail-list">
              <div><dt>Document</dt><dd><%= request.documentType %></dd></div>
              <div><dt>Purpose</dt><dd><%= request.purpose %></dd></div>
              <div><dt>Status</dt><dd><%= request.status %></dd></div>
              <div><dt>Clearance</dt><dd><%= request.clearanceStatus %></dd></div>
              <div><dt>Schedule</dt><dd><%= request.schedule ? `${request.schedule.date} ${request.schedule.time}` : "Not yet assigned" %></dd></div>
              <div><dt>Office remarks</dt><dd><%= request.registrarRemarks || "No remarks yet" %></dd></div>
            </dl>
          </section>

          <% if (canBook) { %>
          <section class="card">
            <h2>Book release appointment</h2>
            <p class="muted tiny">Choose an available slot once your clearance is complete. Each slot accepts up to 5 students.</p>
            <form method="post" action="/student/track/<%= request.id %>/book" class="form">
              <label>
                Available slot
                <select name="scheduleSlot" id="scheduleSlot" required>
                  <option value="">Select date and time</option>
                  <% slots.filter((s) => s.available).forEach((slot) => { %>
                  <option value="<%= slot.date %>|<%= slot.time %>"><%= slot.date %> <%= slot.time %> (<%= slot.capacity - slot.booked %> left)</option>
                  <% }) %>
                </select>
              </label>
              <input type="hidden" name="scheduleDate" id="scheduleDate" />
              <input type="hidden" name="scheduleTime" id="scheduleTime" />
              <button type="submit" class="btn-solid">Book appointment</button>
            </form>
            <script>
              document.getElementById("scheduleSlot")?.addEventListener("change", (e) => {
                const [date, time] = (e.target.value || "").split("|");
                document.getElementById("scheduleDate").value = date || "";
                document.getElementById("scheduleTime").value = time || "";
              });
            </script>
          </section>
          <% } %>

          <% if (canReschedule) { %>
          <section class="card">
            <h2>Reschedule appointment</h2>
            <p class="muted tiny">Current slot: <strong><%= request.schedule.date %> <%= request.schedule.time %></strong></p>
            <form method="post" action="/student/track/<%= request.id %>/reschedule" class="form">
              <label>
                New slot
                <select name="scheduleSlot" id="rescheduleSlot" required>
                  <option value="">Select date and time</option>
                  <% slots.filter((s) => s.available || (s.date === request.schedule.date && s.time === request.schedule.time)).forEach((slot) => { %>
                  <option value="<%= slot.date %>|<%= slot.time %>" <%= slot.date === request.schedule.date && slot.time === request.schedule.time ? 'selected' : '' %>><%= slot.date %> <%= slot.time %> (<%= slot.capacity - slot.booked %> left)</option>
                  <% }) %>
                </select>
              </label>
              <input type="hidden" name="scheduleDate" id="rescheduleDate" />
              <input type="hidden" name="scheduleTime" id="rescheduleTime" />
              <button type="submit" class="btn-solid">Save new time</button>
            </form>
            <script>
              (function () {
                const select = document.getElementById("rescheduleSlot");
                const sync = () => {
                  const [date, time] = (select?.value || "").split("|");
                  document.getElementById("rescheduleDate").value = date || "";
                  document.getElementById("rescheduleTime").value = time || "";
                };
                select?.addEventListener("change", sync);
                sync();
              })();
            </script>
          </section>
          <% } %>

          <% if (canCancel) { %>
          <section class="card">
            <h2>Cancel appointment</h2>
            <p class="muted tiny">Cancelling returns your request to <strong>For Verification</strong>. You can book again when ready.</p>
            <form method="post" action="/student/track/<%= request.id %>/cancel-appointment" class="form" onsubmit="return confirm('Cancel this release appointment?');">
              <button type="submit" class="btn-outline">Cancel appointment</button>
            </form>
          </section>
          <% } %>

          <section class="card">
            <h2>Uploaded Proof</h2>
            <% if (request.uploadedFilePath) { %>
            <p><a class="table-link" href="<%= request.uploadedFilePath %>" target="_blank">View uploaded file</a></p>
            <img src="<%= request.uploadedFilePath %>" alt="Uploaded proof document" class="preview" />
            <% } else { %>
            <p class="muted">No payment receipt uploaded.</p>
            <% } %>
          </section>

          <section class="card full">
            <h2>OCR Verification Result</h2>
            <% if (request.ocr.state === "not_run") { %>
              <p class="muted">OCR has not been run yet by the registrar office.</p>
            <% } else if (request.ocr.state === "failed") { %>
              <p class="alert error">OCR processing failed. Registrar may re-run or encode manually.</p>
            <% } else { %>
              <p class="muted">OCR State: <strong><%= request.ocr.state %></strong> | Confidence: <strong><%= request.ocr.confidence ?? "N/A" %>%</strong></p>
              <dl class="detail-list">
                <div><dt>Student Name</dt><dd><%= request.ocr.extracted.studentName || "-" %></dd></div>
                <div><dt>Student ID</dt><dd><%= request.ocr.extracted.studentId || "-" %></dd></div>
                <div><dt>OR Number</dt><dd><%= request.ocr.extracted.orNumber || "-" %></dd></div>
                <div><dt>Amount</dt><dd><%= request.ocr.extracted.amount || "-" %></dd></div>
                <div><dt>Payment Date</dt><dd><%= request.ocr.extracted.paymentDate || "-" %></dd></div>
              </dl>
            <% } %>
          </section>
        </section>
      </main>
    </div>
  </body>
</html>
