<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>Reset password</title>
  </head>
  <body class="auth-bg">
    <main class="card auth-card">
      <%- include('partials/auth-header') %>
      <h1>Reset password</h1>
      <p class="muted auth-lead">Choose a new password for your account.</p>

      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert success"><%= success %></div><% } %>

      <% if (token) { %>
      <form method="post" action="/reset-password/<%= token %>" class="form">
        <label>
          New password
          <input type="password" name="newPassword" minlength="6" required autofocus />
        </label>
        <label>
          Confirm new password
          <input type="password" name="confirmPassword" minlength="6" required />
        </label>
        <button type="submit">Update password</button>
      </form>
      <% } %>

      <p class="tiny muted auth-links">
        <a href="/login">Back to sign in</a>
      </p>
    </main>
  </body>
</html>
