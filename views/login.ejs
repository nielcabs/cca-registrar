<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>CCA Registrar System - Login</title>
  </head>
  <body class="auth-bg">
    <main class="card auth-card">
      <div class="brand" style="margin-bottom: 0.5rem;">CCA Registrar</div>
      <h1 style="margin: 0 0 0.35rem;">Welcome back</h1>
      <p class="muted">Document requisition, clearance verification &amp; scheduling</p>

      <% if (error) { %>
      <div class="alert error"><%= error %></div>
      <% } %>
      <% if (success) { %>
      <div class="alert success"><%= success %></div>
      <% } %>

      <form method="post" action="/login" class="form">
        <label>
          Email
          <input type="email" name="email" placeholder="you@cca.edu.ph" required autofocus />
        </label>
        <label>
          Password
          <input type="password" name="password" required />
        </label>
        <button type="submit">Sign in</button>
      </form>

      <p class="tiny muted" style="margin-top: 0.75rem;">
        <a href="/forgot-password">Forgot password?</a>
      </p>

      <p class="tiny muted" style="margin-top: 0.35rem;">
        New student? <a href="/register">Create an account</a>
      </p>
    </main>
  </body>
</html>
