<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>New Document Request</title>
  </head>
  <body class="app-body">
    <div class="dashboard-shell">
      <%- include('partials/sidebar', { user, active: 'new-request' }) %>
      <main class="main-panel">
        <%- include('partials/topbar', {
          title: 'Create New Request',
          subtitle: user.hasScholarship
            ? 'Select one or more documents below. Scholarship students may submit without a payment receipt.'
            : 'Select one or more documents below. A payment receipt (OR) is required.',
          actionsHtml: '<a class="btn-link" href="/student/dashboard">Back to Dashboard</a>'
        }) %>

        <section class="hero-banner">
          <h2>Request Submission</h2>
          <p>Check every document you need in this transaction. One shared receipt applies to the whole batch when you upload one.</p>
        </section>

        <section class="card narrow">
          <% if (error) { %><div class="alert error"><%= error %></div><% } %>

          <form method="post" action="/student/new-request" enctype="multipart/form-data" class="form">
            <fieldset class="checkbox-group">
              <legend>Document types (select one or more)</legend>
              <% documentTypes.forEach((doc) => { %>
              <label class="checkbox-row">
                <input type="checkbox" name="documentTypes" value="<%= doc %>" />
                <%= doc %>
              </label>
              <% }) %>
            </fieldset>

            <label>
              Purpose
              <textarea name="purpose" rows="3" placeholder="Employment, scholarship, transfer, etc." required></textarea>
            </label>

            <label>
              Upload Payment Proof (JPG/PNG/PDF, max 5 MB)
              <% if (user.hasScholarship) { %>
              <span class="muted tiny">Optional — your account is marked as scholarship. You may submit without a receipt; the registrar may still verify payment separately.</span>
              <input type="file" name="documentFile" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" />
              <% } else { %>
              <span class="muted tiny">Required — attach a clear photo or scan of your official receipt (OR).</span>
              <input type="file" name="documentFile" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" required />
              <% } %>
            </label>

            <button type="submit">Submit Request<%= documentTypes.length > 1 ? 's' : '' %></button>
          </form>
        </section>
      </main>
    </div>
  </body>
</html>
