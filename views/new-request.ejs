<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>New Document Request</title>
  </head>
  <body class="app-body">
    <div class="dashboard-shell">
      <%- include('partials/sidebar', { user, active: 'new-request' }) %>
      <main class="main-panel">
        <%- include('partials/topbar', {
          title: 'Create New Request',
          subtitle: user.hasScholarship
            ? 'Scholarship student — receipt upload is optional. Select one or more documents below.'
            : 'Non-scholarship student — attach payment receipt (JPG or PNG). Select one or more documents.',
          actionsHtml: '<a class="btn-link" href="/student/dashboard">Back to Dashboard</a>'
        }) %>

        <section class="hero-banner">
          <h2>Request Submission</h2>
          <p>Check every document you need in this transaction. One shared receipt applies to the whole batch.</p>
        </section>

        <section class="card narrow">
          <% if (error) { %><div class="alert error"><%= error %></div><% } %>

          <form method="post" action="/student/new-request" enctype="multipart/form-data" class="form">
            <fieldset class="checkbox-group">
              <legend>Document types (select one or more)</legend>
              <% documentTypes.forEach((doc) => { %>
              <label class="checkbox-row">
                <input type="checkbox" name="documentTypes" value="<%= doc %>" />
                <%= doc %>
              </label>
              <% }) %>
            </fieldset>

            <label>
              Purpose
              <textarea name="purpose" rows="3" placeholder="Employment, scholarship, transfer, etc." required></textarea>
            </label>

            <label>
              Upload Payment Proof (JPG/PNG only, max 5 MB)
              <% if (user.hasScholarship) { %>
              <span class="muted tiny">Optional for scholarship students</span>
              <% } else { %>
              <span class="muted tiny">Required for non-scholarship students</span>
              <% } %>
              <input type="file" name="documentFile" accept=".jpg,.jpeg,.png" <%= user.hasScholarship ? '' : 'required' %> />
            </label>

            <button type="submit">Submit Request<%= documentTypes.length > 1 ? 's' : '' %></button>
          </form>
        </section>
      </main>
    </div>
  </body>
</html>
