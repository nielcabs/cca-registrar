<% const fieldName = typeof name !== 'undefined' ? name : 'course'; %>
<% const fieldId = typeof id !== 'undefined' ? id : fieldName; %>
<% const selectedValue = typeof selected !== 'undefined' ? selected : ''; %>
<% const isRequired = typeof required !== 'undefined' && required; %>
<% const groups = typeof courseGroups !== 'undefined' ? courseGroups : []; %>
<fieldset class="course-picker-fieldset">
  <legend><%= typeof legend !== 'undefined' ? legend : 'Institute / Program' %></legend>
  <div
    class="course-picker"
    data-field-id="<%= fieldId %>"
    data-selected="<%= selectedValue %>"
    data-required="<%= isRequired ? '1' : '0' %>"
  >
    <script type="application/json" class="course-picker-data"><%- JSON.stringify(groups) %></script>
    <label class="course-picker-step">
      <span class="course-picker-step-label">Institute</span>
      <select class="course-picker-institute" aria-label="Institute">
        <option value="">Select institute</option>
        <% groups.forEach((group, index) => { %>
        <option value="<%= index %>"><%= group.institute %></option>
        <% }) %>
      </select>
    </label>
    <label class="course-picker-step">
      <span class="course-picker-step-label">Program</span>
      <select
        name="<%= fieldName %>"
        id="<%= fieldId %>"
        class="course-picker-program"
        aria-label="Program"
        <%= isRequired ? 'required' : '' %>
        disabled
      >
        <option value="">Select program</option>
      </select>
    </label>
  </div>
</fieldset>
