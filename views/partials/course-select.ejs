<% const fieldName = typeof name !== 'undefined' ? name : 'course'; %>
<% const fieldId = typeof id !== 'undefined' ? id : fieldName; %>
<% const selectedValue = typeof selected !== 'undefined' ? selected : ''; %>
<% const isRequired = typeof required !== 'undefined' && required; %>
<% const groups = typeof courseGroups !== 'undefined' ? courseGroups : []; %>
<select name="<%= fieldName %>" id="<%= fieldId %>"<%= isRequired ? ' required' : '' %>>
  <option value="">Select institute / program</option>
  <% groups.forEach((group) => { %>
  <optgroup label="<%= group.institute %>">
    <% group.courses.forEach((course) => { %>
    <option value="<%= course %>" <%= selectedValue === course ? 'selected' : '' %>><%= course %></option>
    <% }) %>
  </optgroup>
  <% }) %>
  <% if (selectedValue && !groups.some((g) => g.courses.includes(selectedValue))) { %>
  <option value="<%= selectedValue %>" selected><%= selectedValue %> (legacy)</option>
  <% } %>
</select>
