<% const initials = (user.displayName || user.email || "U").split(" ").map((p) => p[0]).slice(0, 2).join("").toUpperCase(); %>
<% 
  let notifBase = "/student/notifications";
  if (user.role === "department") notifBase = "/department/notifications";
  else if (user.role === "admin" || user.role === "registrar" || user.role === "vpaa") notifBase = "/admin/notifications";
  const recentNotifs = typeof recentNotifications !== "undefined" ? recentNotifications : [];
  const unreadCount = typeof unreadNotificationsCount !== "undefined" ? unreadNotificationsCount : 0;
%>
<header class="main-topbar">
  <div>
    <h1><%= title %></h1>
    <% if (typeof subtitle !== "undefined" && subtitle) { %>
      <p><%= subtitle %></p>
    <% } %>
  </div>
  <div class="actions">
    <% if (typeof actionsHtml !== "undefined" && actionsHtml) { %>
      <div class="actions-primary"><%- actionsHtml %></div>
    <% } %>

    <div class="topbar-user-tools">
      <div class="notif-wrap">
      <button type="button" class="notif-bell" aria-label="Notifications" aria-expanded="false" aria-haspopup="true">
        <svg class="notif-bell-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2a5 5 0 0 0-5 5v2.1c0 .9-.3 1.8-.9 2.5L4.3 14.8A1.5 1.5 0 0 0 5.6 17h12.8a1.5 1.5 0 0 0 1.3-2.2l-1.8-3.2a4.2 4.2 0 0 1-.9-2.5V7a5 5 0 0 0-5-5zM9.5 19a2.5 2.5 0 0 0 5 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <% if (unreadCount > 0) { %>
          <span class="notif-badge"><%= unreadCount > 99 ? "99+" : unreadCount %></span>
        <% } else { %>
          <span class="notif-badge" hidden>0</span>
        <% } %>
      </button>

      <div class="notif-panel" hidden>
        <div class="notif-panel-head">
          <strong>Notifications</strong>
          <a class="notif-view-all" href="<%= notifBase %>">View all</a>
        </div>

        <% if (!recentNotifs.length) { %>
          <p class="notif-empty">No notifications yet.</p>
        <% } else { %>
          <div class="notif-list">
            <% recentNotifs.forEach((n) => { %>
              <div class="notif-item <%= n.isRead ? '' : 'is-unread' %>" data-id="<%= n.id %>" role="button" tabindex="0">
                <span class="notif-item-head">
                  <strong><%= n.title %></strong>
                  <% if (!n.isRead) { %><span class="notif-dot" aria-label="Unread"></span><% } %>
                </span>
                <span class="notif-item-preview"><%= n.message %></span>
                <span class="notif-item-body"><%= n.message %></span>
                <span class="notif-item-time"><%= new Date(n.createdAt).toLocaleString() %></span>
                <% if (n.link) { %>
                  <a class="notif-item-link" href="<%= n.link %>" onclick="event.stopPropagation()">Open related page</a>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="user-chip" title="<%= user.email %>">
      <span class="user-avatar"><%= initials %></span>
      <span class="user-chip-meta">
        <strong><%= user.displayName %></strong>
        <span><%= user.role === 'student' ? 'Student' : user.role === 'vpaa' ? 'VPAA' : (user.role === 'registrar' || user.role === 'admin') ? 'Registrar' : user.role === 'department' ? 'Department' : user.role %></span>
      </span>
    </div>
    <form method="post" action="/logout">
      <button type="submit" class="btn-outline">Logout</button>
    </form>
    </div>
  </div>
</header>
