<% const fieldName = typeof name !== 'undefined' ? name : 'section'; %>
<% const fieldListId = typeof listId !== 'undefined' && listId ? listId : 'section-suggestions'; %>
<% const fieldValue = typeof value !== 'undefined' ? value : ''; %>
<% const fieldPlaceholder = typeof placeholder !== 'undefined' ? placeholder : 'e.g. 1703'; %>
<% const isRequired = typeof required !== 'undefined' && required; %>
<% const sectionList = typeof sections !== 'undefined' && sections ? sections : []; %>
<input
  type="text"
  name="<%= fieldName %>"
  value="<%= fieldValue %>"
  list="<%= fieldListId %>"
  placeholder="<%= fieldPlaceholder %>"
  <%= isRequired ? 'required' : '' %>
/>
<datalist id="<%= fieldListId %>">
  <% sectionList.forEach((s) => { %>
  <option value="<%= s %>"></option>
  <% }) %>
</datalist>
