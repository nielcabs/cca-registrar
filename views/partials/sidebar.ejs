<aside class="sidebar">
  <div class="brand">CCA Registrar</div>
  <p class="sidebar-role">
    <% if (user.role === "student") { %>Student portal
    <% } else if (user.role === "admin" || user.role === "registrar") { %>Registrar office
    <% } else if (user.role === "vpaa") { %>VPAA · view only
    <% } else if (user.role === "department") { %>Department officer
    <% } %>
  </p>

  <nav class="menu">
    <% if (user.role === "student") { %>
      <a href="/student/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>"><span class="nav-icon nav-icon-dashboard"></span>My dashboard</a>
      <a href="/student/notifications" class="<%= active === 'notifications' ? 'active' : '' %>">
        <span class="nav-icon nav-icon-bell"></span>Notifications
        <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
          <span class="pill"><%= unreadNotificationsCount %></span>
        <% } %>
      </a>
      <a href="/student/new-request" class="<%= active === 'new-request' ? 'active' : '' %>"><span class="nav-icon nav-icon-doc"></span>New document request</a>
      <a href="/student/clearance" class="<%= active === 'clearance' ? 'active' : '' %>"><span class="nav-icon nav-icon-clear"></span>My clearance status</a>
      <a href="/change-password" class="<%= active === 'password' ? 'active' : '' %>"><span class="nav-icon nav-icon-lock"></span>Change password</a>
      <a href="/notification-settings" class="<%= active === 'notify-settings' ? 'active' : '' %>"><span class="nav-icon nav-icon-bell"></span>Email &amp; SMS alerts</a>
    <% } else if (user.role === "admin" || user.role === "registrar" || user.role === "vpaa") { %>
      <a href="/admin/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>"><span class="nav-icon nav-icon-dashboard"></span>Overview dashboard</a>
      <a href="/admin/notifications" class="<%= active === 'notifications' ? 'active' : '' %>">
        <span class="nav-icon nav-icon-bell"></span>Notifications
        <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
          <span class="pill"><%= unreadNotificationsCount %></span>
        <% } %>
      </a>
      <% if (user.role !== "vpaa") { %>
      <a href="/admin/announcements" class="<%= active === 'announcements' ? 'active' : '' %>"><span class="nav-icon nav-icon-bell"></span>Announcements</a>
      <% } %>
      <a href="/admin/requests" class="<%= active === 'requests' ? 'active' : '' %>"><span class="nav-icon nav-icon-doc"></span>Document requests</a>
      <a href="/admin/clearances" class="<%= active === 'clearances' ? 'active' : '' %>"><span class="nav-icon nav-icon-clear"></span>Student clearances</a>
      <a href="/admin/reports" class="<%= active === 'reports' ? 'active' : '' %>"><span class="nav-icon nav-icon-report"></span>Reports &amp; export</a>
      <% if (user.role !== "vpaa") { %>
      <a href="/admin/users" class="<%= active === 'users' ? 'active' : '' %>"><span class="nav-icon nav-icon-users"></span>User accounts</a>
      <% } %>
      <a href="/change-password" class="<%= active === 'password' ? 'active' : '' %>"><span class="nav-icon nav-icon-lock"></span>Change password</a>
      <a href="/notification-settings" class="<%= active === 'notify-settings' ? 'active' : '' %>"><span class="nav-icon nav-icon-bell"></span>Email &amp; SMS alerts</a>
    <% } else if (user.role === "department") { %>
      <a href="/department/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>"><span class="nav-icon nav-icon-office"></span>My office — clearances</a>
      <a href="/department/notifications" class="<%= active === 'notifications' ? 'active' : '' %>">
        <span class="nav-icon nav-icon-bell"></span>Notifications
        <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
          <span class="pill"><%= unreadNotificationsCount %></span>
        <% } %>
      </a>
      <a href="/change-password" class="<%= active === 'password' ? 'active' : '' %>"><span class="nav-icon nav-icon-lock"></span>Change password</a>
      <a href="/notification-settings" class="<%= active === 'notify-settings' ? 'active' : '' %>"><span class="nav-icon nav-icon-bell"></span>Email &amp; SMS alerts</a>
    <% } %>
  </nav>

  <div class="sidebar-foot">
    <p><strong><%= user.displayName %></strong></p>
    <p class="muted tiny"><%= user.email || '' %></p>
    <% if (user.role === "student") { %>
      <p class="muted tiny">ID: <%= user.studentId %></p>
    <% } else if (user.role === "department") { %>
      <p class="muted tiny">Office: <%= user.departmentCode %></p>
    <% } %>
  </div>
</aside>
