<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>Student clearances — Registrar</title>
  </head>
  <body class="app-body">
    <div class="dashboard-shell">
      <%- include('partials/sidebar', { user, active: 'clearances' }) %>
      <main class="main-panel">
        <%- include('partials/topbar', {
          title: 'Student clearance overview',
          subtitle: 'Filter by institute and section. Clearance offices differ by student category (Undergrad, Graduating, Graduate).'
        }) %>

        <section class="card panel-toolbar">
          <form method="get" action="/admin/clearances" class="form two-col form-end">
            <label class="full-row">
              Search students (name, student ID, or email)
              <input type="search" name="q" value="<%= searchQuery || '' %>" placeholder="e.g. Maria, 20230002, @cca.edu.ph" />
            </label>
            <label>
              Institute
              <select name="course">
                <option value="">All institutes</option>
                <% courses.forEach((c) => { %>
                <option value="<%= c %>" <%= courseFilter === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </label>
            <label>
              Section
              <select name="section">
                <option value="">All sections</option>
                <% sections.forEach((s) => { %>
                <option value="<%= s %>" <%= sectionFilter === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </label>
            <button type="submit">Apply filters</button>
            <% if (searchQuery || courseFilter || sectionFilter) { %>
            <a class="btn-link" href="/admin/clearances">Clear filters</a>
            <% } %>
          </form>
        </section>

        <section class="hero-banner">
          <h2>Registrar clearance monitoring</h2>
          <p>Undergraduate & Graduating: Library → MISSO → Extension → Guidance → Student Affairs → Finance → Registrar. Graduate (Alumni): includes Alumni Office.</p>
        </section>

        <section class="card data-card">
          <div class="card-head">
            <h2>Students (<%= rows.length %>)</h2>
          </div>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Student ID</th>
                  <th>Name</th>
                  <th>Category</th>
                  <th>Institute</th>
                  <th>Section</th>
                  <th>Offices signed</th>
                  <th>Overall</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (!rows.length) { %>
                <tr><td colspan="8" class="muted center">No students match this search.</td></tr>
                <% } %>
                <% rows.forEach((r) => { %>
                <tr>
                  <td><%= r.studentId %></td>
                  <td><%= r.displayName %></td>
                  <td><%= r.categoryLabel %></td>
                  <td class="tiny"><%= r.course || '—' %></td>
                  <td><%= r.section || '—' %></td>
                  <td><%= r.nSigned %> / <%= r.nRequired %></td>
                  <td><span class="badge <%= r.summaryBadge %>"><%= r.clearanceSummary %></span></td>
                  <td><a class="table-link" href="/admin/clearance/<%= r.studentId %>">Open detail</a></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
