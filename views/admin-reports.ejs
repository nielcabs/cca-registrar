<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>Reports</title>
  </head>
  <body class="app-body">
    <div class="dashboard-shell">
      <%- include('partials/sidebar', { user, active: 'reports' }) %>
      <main class="main-panel">
        <%- include('partials/topbar', {
          title: 'Reports & statistics',
          subtitle: readOnly ? 'View-only summary for VPAA.' : 'On-screen summary and downloadable PDF for presentations or records.',
          actionsHtml: readOnly ? '' : '<a class="btn-solid" href="/admin/reports/export.pdf">Download PDF report</a>'
        }) %>

        <section class="hero-banner">
          <h2>Transaction report</h2>
          <p>Export includes summary counts, document-type breakdown, and the latest audit trail entries.</p>
        </section>

        <section class="stat-grid">
          <article class="stat-card"><h3><%= stats.totalRequests %></h3><p>Total requests</p></article>
          <article class="stat-card stat-teal"><h3><%= stats.released %></h3><p>Released</p></article>
          <article class="stat-card stat-purple"><h3><%= stats.scheduled %></h3><p>Scheduled</p></article>
          <article class="stat-card stat-orange"><h3><%= stats.rejected %></h3><p>Rejected</p></article>
        </section>

        <section class="grid">
          <section class="card">
            <div class="card-head"><h2>Requests by document type</h2></div>
            <% if (!stats.byDocType.length) { %>
              <p class="muted">No data yet.</p>
            <% } else { %>
              <% const maxDocCount = Math.max(...stats.byDocType.map((d) => d.count)); %>
              <div class="bar-chart">
                <% stats.byDocType.forEach((d, i) => { %>
                <div class="bar-row">
                  <span class="bar-row-label"><%= d.documentType %></span>
                  <span class="bar-row-meta"><%= d.count %></span>
                  <div class="bar-track">
                    <div class="bar-fill <%= i % 3 === 1 ? 'bar-fill-teal' : i % 3 === 2 ? 'bar-fill-purple' : '' %>" style="width: <%= Math.round((d.count / maxDocCount) * 100) %>%;"></div>
                  </div>
                </div>
                <% }) %>
              </div>
            <% } %>
          </section>

          <section class="card">
            <div class="card-head"><h2>Requests by Month</h2></div>
            <% if (!stats.byMonth.length) { %>
              <p class="muted">No data yet.</p>
            <% } else { %>
              <table class="data-table">
                <thead><tr><th>Month</th><th>Count</th></tr></thead>
                <tbody>
                  <% stats.byMonth.forEach((m) => { %>
                  <tr><td><%= m.month %></td><td><%= m.count %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            <% } %>
          </section>

          <section class="card full">
            <div class="card-head"><h2>Recent Audit Log (<%= audit.length %>)</h2></div>
            <% if (!audit.length) { %>
              <p class="muted">No audit entries yet.</p>
            <% } else { %>
              <div class="table-wrap">
                <table class="data-table">
                  <thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Details</th></tr></thead>
                  <tbody>
                    <% audit.forEach((a) => { %>
                    <tr>
                      <td class="tiny"><%= a.at_formatted %></td>
                      <td><%= a.actor_email %></td>
                      <td><%= a.action %></td>
                      <td class="tiny muted"><%= a.details %></td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </section>
        </section>
      </main>
    </div>
  </body>
</html>
