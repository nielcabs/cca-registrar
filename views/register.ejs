<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>Student Registration</title>
  </head>
  <body class="auth-bg">
    <main class="card auth-card" style="width: min(560px, 92vw);">
      <div class="brand" style="margin-bottom: 0.5rem;">CCA Registrar</div>
      <h1 style="margin: 0 0 0.35rem;">Create student account</h1>
      <p class="muted">Register with your @cca.edu.ph school email. Accounts require registrar verification before submitting requests.</p>

      <% if (error) { %>
      <div class="alert error"><%= error %></div>
      <% } %>

      <form method="post" action="/register" class="form">
        <label>
          Full Name
          <input type="text" name="displayName" value="<%= form.displayName || '' %>" placeholder="Juan Dela Cruz" required />
        </label>
        <label>
          Student ID
          <input type="text" name="studentId" value="<%= form.studentId || '' %>" placeholder="2023001234" required />
        </label>
        <label>
          Student category
          <select name="studentCategory" required>
            <option value="">Select category</option>
            <% categories.forEach((c) => { %>
            <option value="<%= c.value %>" <%= form.studentCategory === c.value ? 'selected' : '' %>><%= c.label %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Institute / Program
          <%- include('partials/course-select', { name: 'course', selected: form.course || '', required: true, courseGroups }) %>
        </label>
        <label>
          Section
          <%- include('partials/section-input', { name: 'section', value: form.section || '', sections: sectionSuggestions }) %>
        </label>
        <label>
          Year level
          <select name="yearLevel">
            <option value="">Select year level (optional)</option>
            <% yearLevels.forEach((y) => { %>
            <option value="<%= y %>" <%= form.yearLevel === y ? 'selected' : '' %>><%= y %> year</option>
            <% }) %>
          </select>
        </label>
        <label>
          Semester
          <select name="semester">
            <option value="">Select semester (optional)</option>
            <% semesters.forEach((s) => { %>
            <option value="<%= s %>" <%= form.semester === s ? 'selected' : '' %>><%= s %> semester</option>
            <% }) %>
          </select>
        </label>
        <label>
          School email (@cca.edu.ph)
          <input type="email" name="email" value="<%= form.email || '' %>" placeholder="you@cca.edu.ph" required />
        </label>
        <label>
          Mobile number (optional, for SMS alerts)
          <input type="tel" name="phone" value="<%= form.phone || '' %>" placeholder="09171234567" />
        </label>
        <p class="tiny muted" style="margin-bottom: 0.75rem;">Scholarship status is assigned by the registrar office after review — not during self-registration.</p>
        <label>
          Password
          <input type="password" name="password" minlength="6" required />
        </label>
        <label>
          Confirm Password
          <input type="password" name="confirmPassword" minlength="6" required />
        </label>
        <button type="submit">Register</button>
      </form>

      <p class="tiny muted" style="margin-top: 0.9rem;">
        Already have an account? <a href="/login">Sign in</a>
      </p>
    </main>
  </body>
</html>
