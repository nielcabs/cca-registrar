<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>Forgot password</title>
  </head>
  <body class="auth-bg">
    <main class="card auth-card">
      <div class="brand" style="margin-bottom: 0.5rem;">CCA Registrar</div>
      <h1 style="margin: 0 0 0.35rem;">Forgot password</h1>
      <p class="muted">Enter your school email and we will send a reset link if the account exists.</p>

      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert success"><%= success %></div><% } %>

      <form method="post" action="/forgot-password" class="form">
        <label>
          School email
          <input type="email" name="email" placeholder="you@cca.edu.ph" required autofocus />
        </label>
        <button type="submit">Send reset link</button>
      </form>

      <p class="tiny muted" style="margin-top: 0.9rem;">
        <a href="/login">Back to sign in</a>
      </p>
    </main>
  </body>
</html>
