<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title>User accounts — Registrar</title>
  </head>
  <body class="app-body">
    <div class="dashboard-shell">
      <%- include('partials/sidebar', { user, active: 'users' }) %>
      <main class="main-panel">
        <%- include('partials/topbar', {
          title: 'User account management',
          subtitle: 'Search and manage logins. The main registrar account is pre-seeded — expand below only when adding new users.'
        }) %>

        <% if (error) { %><div class="alert error"><%= error %></div><% } %>
        <% if (success) { %><div class="alert success"><%= success %></div><% } %>

        <div class="filter-tabs mb-sm">
          <% const usersQuery = []; if (typeof searchQuery !== 'undefined' && searchQuery) usersQuery.push('q=' + encodeURIComponent(searchQuery)); if (typeof courseFilter !== 'undefined' && courseFilter) usersQuery.push('course=' + encodeURIComponent(courseFilter)); if (typeof sectionFilter !== 'undefined' && sectionFilter) usersQuery.push('section=' + encodeURIComponent(sectionFilter)); const usersQs = usersQuery.length ? ('?' + usersQuery.join('&')) : ''; %>
          <a class="btn-link <%= (typeof filter === 'undefined' || filter === 'all') ? 'active-tab' : '' %>" href="/admin/users<%= usersQs %>">All accounts</a>
          <a class="btn-link <%= filter === 'pending' ? 'active-tab' : '' %>" href="/admin/users?filter=pending<%= usersQuery.length ? '&' + usersQuery.join('&') : '' %>">Pending verification<% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %> (<%= pendingCount %>)<% } %></a>
        </div>

        <section class="card panel-toolbar">
          <form method="get" action="/admin/users" class="filter-form">
            <% if (typeof filter !== 'undefined' && filter === 'pending') { %><input type="hidden" name="filter" value="pending" /><% } %>
            <label class="filter-search">
              Search name, email, ID, office
              <input type="search" name="q" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" placeholder="Juan, 20230001, @cca.edu.ph…" autocomplete="off" />
            </label>
            <div class="filter-controls">
              <label class="filter-field">
                Program
                <select name="course">
                  <option value="">All programs</option>
                  <% if (typeof courses !== 'undefined') { courses.forEach((c) => { %>
                  <option value="<%= c %>" <%= typeof courseFilter !== 'undefined' && courseFilter === c ? 'selected' : '' %>><%= c %></option>
                  <% }) } %>
                </select>
              </label>
              <label class="filter-field">
                Section
                <select name="section">
                  <option value="">All sections</option>
                  <% if (typeof sections !== 'undefined') { sections.forEach((s) => { %>
                  <option value="<%= s %>" <%= typeof sectionFilter !== 'undefined' && sectionFilter === s ? 'selected' : '' %>><%= s %></option>
                  <% }) } %>
                </select>
              </label>
              <div class="filter-actions">
                <button type="submit" class="btn-solid">Apply filters</button>
                <% if ((typeof searchQuery !== 'undefined' && searchQuery) || (typeof courseFilter !== 'undefined' && courseFilter) || (typeof sectionFilter !== 'undefined' && sectionFilter)) { %>
                <a class="btn-link" href="/admin/users<%= typeof filter !== 'undefined' && filter === 'pending' ? '?filter=pending' : '' %>">Clear</a>
                <% } %>
              </div>
            </div>
          </form>
        </section>

        <section class="card data-card">
          <div class="card-head-row">
            <h2>Accounts</h2>
          </div>
          <p class="accounts-meta">
            Showing <strong><%= users.length %></strong><% if (typeof searchQuery !== 'undefined' && searchQuery) { %> match(es) for “<%= searchQuery %>”<% } else { %> account(s)<% } %>.
          </p>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Email (login)</th>
                  <th>Display name</th>
                  <th>Role</th>
                  <th>Student ID / office</th>
                  <th>Category / institute</th>
                  <th>Verified</th>
                  <% if (typeof filter !== 'undefined' && filter === 'pending') { %><th>Roster check</th><% } %>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (!users.length) { %>
                <tr>
                  <td colspan="<%= typeof filter !== 'undefined' && filter === 'pending' ? 9 : 8 %>" class="muted"><%= (typeof searchQuery !== 'undefined' && searchQuery) ? 'No accounts match this search.' : 'No user accounts yet.' %></td>
                </tr>
                <% } %>
                <% users.forEach((u) => { %>
                <tr>
                  <td><%= u.email %></td>
                  <td><%= u.displayName %></td>
                  <td><%= (u.role === 'admin' || u.role === 'registrar') ? 'Registrar' : u.role === 'sysadmin' ? 'System admin' : u.role === 'student' ? 'Student' : u.role === 'department' ? 'Department' : u.role === 'vpaa' ? 'VPAA (view only)' : u.role %></td>
                  <td><%= u.studentId || u.departmentCode || '—' %></td>
                  <td class="tiny">
                    <% if (u.role === 'student') { %>
                    <%= u.studentCategory || 'undergraduate' %><% if (u.course) { %> · <%= u.course %><% } %><% if (u.section) { %> / <%= u.section %><% } %>
                    <% if (u.hasScholarship) { %> · scholarship<% } %>
                    <% } else { %>—<% } %>
                  </td>
                  <td>
                    <% if (u.role === 'student') { %>
                      <% if (u.isVerified) { %><span class="badge badge-released">Yes</span><% } else { %><span class="badge badge-verify">Pending</span><% } %>
                    <% } else { %>—<% } %>
                  </td>
                  <% if (typeof filter !== 'undefined' && filter === 'pending') { %>
                  <td class="tiny">
                    <% if (u.role === 'student' && !u.isVerified && u.rosterStatus) { %>
                      <span class="badge <%= u.rosterStatusBadge %>"><%= u.rosterStatusLabel %></span>
                      <% if (u.rosterWarnings && u.rosterWarnings.length) { %>
                        <div class="muted"><%= u.rosterWarnings[0] %></div>
                      <% } %>
                    <% } else { %>—<% } %>
                  </td>
                  <% } %>
                  <td class="tiny"><%= new Date(u.createdAt).toLocaleDateString() %></td>
                  <td class="nowrap">
                    <a class="table-link" href="/admin/users/<%= u.id %>/edit">Edit</a>
                    <% if (u.role === 'student' && !u.isVerified) { %>
                      <form method="post" action="/admin/users/<%= u.id %>/verify" class="inline-form">
                        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                        <input type="hidden" name="redirectSearch" value="<%= searchQuery %>" />
                        <% } %>
                        <button type="submit" class="ghost tiny">Verify</button>
                      </form>
                    <% } else if (u.role === 'student' && u.isVerified) { %>
                      <form method="post" action="/admin/users/<%= u.id %>/unverify" class="inline-form">
                        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                        <input type="hidden" name="redirectSearch" value="<%= searchQuery %>" />
                        <% } %>
                        <button type="submit" class="ghost tiny">Unverify</button>
                      </form>
                    <% } %>
                    <% if (u.email !== user.email) { %>
                    <form method="post" action="/admin/users/<%= u.id %>/delete" style="display:inline;" onsubmit="return confirm('Permanently delete <%= u.email %>?');">
                      <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                      <input type="hidden" name="redirectSearch" value="<%= searchQuery %>" />
                      <% } %>
                      <button type="submit" class="ghost tiny">Delete</button>
                    </form>
                    <% } else { %>
                    <span class="muted tiny">This session</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>

        <details class="create-panel">
          <summary>Create new account — student, department officer, registrar, or VPAA</summary>
          <p class="tiny muted" style="margin-top:0;">Students may also register from the login page.</p>
          <form method="post" action="/admin/users/create" class="form two-col">
            <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
            <input type="hidden" name="redirectSearch" value="<%= searchQuery %>" />
            <% } %>
            <label>
              Account role
              <select name="role" id="roleSelect" required>
                <option value="">Select role</option>
                <option value="student">Student</option>
                <option value="department">Department officer (Library, Finance, Alumni, etc.)</option>
                <option value="registrar">Additional registrar staff</option>
                <option value="sysadmin">System administrator</option>
                <option value="vpaa">VPAA (view only)</option>
              </select>
            </label>
            <label>
              Full display name
              <input type="text" name="displayName" required placeholder="As it should appear in the system" />
            </label>
            <label>
              Email (used as login)
              <input type="email" name="email" required placeholder="name@cca.edu.ph" />
            </label>
            <label>
              Initial password (min. 6 characters)
              <input type="password" name="password" minlength="6" required />
            </label>
            <label id="studentIdField" style="display:none;">
              Student ID number
              <input type="text" name="studentId" placeholder="e.g. 2023001234" />
            </label>
            <label id="studentCategoryField" style="display:none;">
              Student category
              <select name="studentCategory">
                <option value="">Select category</option>
                <% (categories || []).forEach((c) => { %>
                <option value="<%= c.value %>"><%= c.label %></option>
                <% }) %>
              </select>
            </label>
            <div id="courseField" style="display:none;">
              <%- include('partials/course-select', { name: 'course', selected: '', required: true, courseGroups }) %>
            </div>
            <label id="sectionField" style="display:none;">
              Section
              <input type="text" name="section" placeholder="e.g. A" />
            </label>
            <label id="scholarshipField" style="display:none;" class="checkbox-row full-row">
              <input type="checkbox" name="hasScholarship" value="1" />
              Active scholarship (registrar assigns — exempts tuition receipt &amp; document OR)
            </label>
            <label id="deptField" style="display:none;">
              Department (for officer login)
              <select name="departmentCode">
                <option value="">Select department</option>
                <% departments.forEach((d) => { %>
                <option value="<%= d.code %>"><%= d.name %></option>
                <% }) %>
              </select>
            </label>
            <button type="submit" class="full-row">Create account</button>
          </form>
        </details>
      </main>
    </div>

    <script>
      (function () {
        var roleSelect = document.getElementById("roleSelect");
        var sidField = document.getElementById("studentIdField");
        var catField = document.getElementById("studentCategoryField");
        var courseField = document.getElementById("courseField");
        var sectionField = document.getElementById("sectionField");
        var scholarshipField = document.getElementById("scholarshipField");
        var deptField = document.getElementById("deptField");
        var sidInput = sidField.querySelector("input");
        var catSelect = catField.querySelector("select");
        var deptSelect = deptField.querySelector("select");
        var courseSelect = courseField.querySelector(".course-picker-program");
        function sync() {
          var v = roleSelect.value;
          var isStudent = v === "student";
          sidField.style.display = isStudent ? "block" : "none";
          catField.style.display = isStudent ? "block" : "none";
          courseField.style.display = isStudent ? "block" : "none";
          sectionField.style.display = isStudent ? "block" : "none";
          scholarshipField.style.display = isStudent ? "flex" : "none";
          deptField.style.display = v === "department" ? "block" : "none";
          sidInput.required = isStudent;
          catSelect.required = isStudent;
          if (courseSelect) courseSelect.required = isStudent;
          deptSelect.required = v === "department";
        }
        roleSelect.addEventListener("change", sync);
        sync();
      })();
    </script>
  </body>
</html>
