# Copy to .env and fill in your keys

# --- Email via Pingram (https://www.pingram.io) ---
PINGRAM_API_KEY=pingram_sk_your_key_here
PINGRAM_BASE_URL=https://api.pingram.io
# PINGRAM_FROM_ADDRESS=registrar@yourdomain.com
# PINGRAM_FROM_NAME=CCA Registrar
# PINGRAM_NOTIFICATION_TYPE=City College of Angeles

NOTIFY_EMAIL_MODE=pingram

# --- SMS via UniSMS (https://unismsapi.com) — Philippine numbers only ---
UNISMS_API_KEY=sk_your_secret_key_here
UNISMS_BASE_URL=https://unismsapi.com/api
UNISMS_SENDER_ID=YourRegisteredSenderId

NOTIFY_SMS_MODE=unisms

# --- Or PhilSMS ---
# PHILSMS_API_TOKEN=your_token_from_dashboard
# PHILSMS_BASE_URL=https://dashboard.philsms.com/api/v3
# PHILSMS_SENDER_ID=CASUGANATICS
# NOTIFY_SMS_MODE=philsms

# --- Or use demo / other providers ---
# NOTIFY_EMAIL_MODE=ethereal   # demo preview link (no .env needed)
# NOTIFY_EMAIL_MODE=smtp
# NOTIFY_SMS_MODE=console      # demo only — shows message in delivery log

# SMTP (if not using Pingram email):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="CCA Registrar <you@gmail.com>"

# Pingram SMS (international — may need country setup):
# NOTIFY_SMS_MODE=pingram
# PINGRAM_SMS_TYPE=sms_compose_preview
# PINGRAM_FROM_NUMBER=+1234567890

# Twilio SMS:
# NOTIFY_SMS_MODE=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

APP_URL=http://localhost:3000
